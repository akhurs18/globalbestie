# ─────────────────────────────────────────────────────────────
# Global Bestie — Environment Variables
# Copy this file to .env (or set them in Netlify → Site → Environment)
# Never commit .env to git.
# ─────────────────────────────────────────────────────────────
#
# Legend
#   [REQUIRED]   nothing works without this
#   [OPTIONAL]   feature degrades but app still runs
#   [DEV-ONLY]   only useful for local development
#   [LEGACY]     kept for backward compatibility, not needed for new deployments
#
# ─────────────────────────────────────────────────────────────


# =============================================================
# CORE — Supabase + Admin Portal
# =============================================================

# [REQUIRED] Supabase dashboard → Settings → API → Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# [REQUIRED] Supabase dashboard → Settings → API → service_role key (Reveal)
# Server-side only — never expose this in the browser
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# [REQUIRED] Admin portal password — protects /portal mutations
# Generate with: openssl rand -base64 32
ADMIN_SHARED_SECRET=replace-with-strong-random-password


# =============================================================
# WHATSAPP / INSTAGRAM AUTOMATION — via Maychats
# Without these the auto-confirm WhatsApp + broadcasts + reply
# tracking + opt-out webhook are dark. Portal still works manually.
# =============================================================

# [OPTIONAL] Shared secret used to verify HMAC-SHA256 signatures on
# inbound webhooks from Maychats. Without it, signature verification
# is SKIPPED — only acceptable during local dev.
MAYCHATS_WEBHOOK_SECRET=

# [OPTIONAL] Bearer API key used when posting outbound WhatsApp / IG
# replies to Maychats. Without it, sendWhatsappMessage returns
# {sent:false, reason:"missing_maychats_api_key"} and order_events
# logs an "auto_whatsapp_failed" entry.
MAYCHATS_API_KEY=

# [OPTIONAL] Maychats account / channel id for the WhatsApp / IG inbox.
# Maychats can usually infer it from the inbound recipient — only set
# this if you have multiple connected numbers on the same account.
MAYCHATS_ACCOUNT_ID=

# [OPTIONAL] Override the Maychats outbound endpoint if you are on a
# non-default region. Defaults to https://api.maychats.com/v1/messages
MAYCHATS_SEND_ENDPOINT=https://api.maychats.com/v1/messages

# [LEGACY] Kept so any existing Meta-style webhook verification
# (hub.challenge) you configured on a custom domain still passes.
# Not required for Maychats.
META_WEBHOOK_VERIFY_TOKEN=


# =============================================================
# TEAM NOTIFICATIONS
# =============================================================

# [OPTIONAL] Slack incoming webhook URL (or any webhook) that
# receives a JSON ping when the Instagram automation hands off to
# a human, when the daily digest fires, etc.
TEAM_ALERT_WEBHOOK_URL=

# [OPTIONAL] Canonical PK mobile that receives the daily team digest
# at 09:00 PKT. Use canonical form (e.g. 923001234567). Anyone else
# you want to opt in goes into the `team_members` Supabase table
# instead so this stays a single owner contact.
TEAM_OWNER_WHATSAPP=


# =============================================================
# MARKETING DEFAULTS
# Override only if you don't want to manage these through the
# Settings tab in the portal.
# =============================================================

# [OPTIONAL] Override the default FX rate used by the daily marketing
# script. The portal Settings → FX rate value is the source of truth
# for everything else — this env var is just a fallback for the
# offline scraper run.
FX_RATE=282

# [OPTIONAL] Default markup rate (0.25 = 25%). Override only when
# you want the marketing script to use a different multiplier than
# the portal Settings value.
MARKUP_RATE=0.25


# =============================================================
# SCRAPER / IMPORT HARDENING
# =============================================================

# [OPTIONAL] Comma-separated list of hostnames the scraper is allowed
# to fetch. Empty = unrestricted. Useful when sharing the scraper
# with vendors.
SCRAPER_ALLOWED_HOSTS=

# [OPTIONAL] Your store's customer-support WhatsApp number for the
# customer-facing "WhatsApp us" buttons. Canonical form, e.g.
# 923001234567. Falls back to Settings → support_whatsapp.
STORE_SUPPORT_WHATSAPP=
