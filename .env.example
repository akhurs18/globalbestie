# ─────────────────────────────────────────────────────────────
# Global Bestie — Environment Variables
# Copy this file to .env and fill in your real values.
# Never commit .env to git.
# ─────────────────────────────────────────────────────────────

# ── REQUIRED: Supabase ───────────────────────────────────────
# Supabase dashboard → Settings → API → Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase dashboard → Settings → API → service_role key (Reveal)
# Server-side only — never expose this in the browser
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── REQUIRED: Admin portal password ─────────────────────────
# Generate with: openssl rand -base64 32
# Used to authenticate the /portal admin dashboard
ADMIN_SHARED_SECRET=replace-with-strong-random-password

# ── OPTIONAL: Instagram / Meta DM automation ─────────────────
# Meta Developer App → Webhooks → Verify Token (you choose this value)
META_WEBHOOK_VERIFY_TOKEN=replace-with-your-verify-token

# Meta Developer App → App Secret
META_APP_SECRET=

# Meta Developer App → Page Access Token (from Graph API Explorer)
META_PAGE_ACCESS_TOKEN=

# Your Facebook Page ID (numeric)
META_PAGE_ID=

# Instagram Business Account ID (numeric)
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Instagram Page Access Token (same as META_PAGE_ACCESS_TOKEN in most setups)
INSTAGRAM_PAGE_ACCESS_TOKEN=

# Meta Graph API version (e.g. v19.0)
META_GRAPH_VERSION=v19.0

# Full Instagram messages endpoint (usually auto-derived, but can be overridden)
META_IG_MESSAGES_ENDPOINT=

# ── OPTIONAL: Team alerts ─────────────────────────────────────
# Slack incoming webhook URL (or any webhook) for human handoff alerts
TEAM_ALERT_WEBHOOK_URL=

# ── OPTIONAL: Marketing agent overrides ──────────────────────
# Override the default FX rate and markup for the daily marketing script
FX_RATE=282
MARKUP_RATE=0.25
