# ─────────────────────────────────────────────────────────────
# Global Bestie — Environment Variables
# Copy this file to .env and fill in your real values.
# Never commit .env to git.
# ─────────────────────────────────────────────────────────────

# ── REQUIRED: Supabase ───────────────────────────────────────
# Supabase dashboard → Settings → API → Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase dashboard → Settings → API → service_role key (Reveal)
# Server-side only — never expose this in the browser
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── REQUIRED: Admin portal password ─────────────────────────
# Generate with: openssl rand -base64 32
# Used to authenticate the /portal admin dashboard
ADMIN_SHARED_SECRET=replace-with-strong-random-password

# ── OPTIONAL: Instagram DM automation via Maychats ──────────
# We now use Maychats as the bridge between Instagram and this app instead of
# calling the Meta Graph API directly. Configure these in Maychats → Settings →
# API and webhook integration.

# Shared secret used to verify HMAC-SHA256 signatures on inbound webhooks
MAYCHATS_WEBHOOK_SECRET=

# Bearer API key used when posting outbound replies to Maychats
MAYCHATS_API_KEY=

# Maychats account / channel id for the Instagram inbox (optional — Maychats
# can infer it from the inbound event's recipient when omitted)
MAYCHATS_ACCOUNT_ID=

# Override the Maychats outbound endpoint if you are on a non-default region
MAYCHATS_SEND_ENDPOINT=https://api.maychats.com/v1/messages

# Optional: kept so any existing Meta-style webhook verification (hub.challenge)
# you may have configured on a custom domain still passes. Not required for
# Maychats.
META_WEBHOOK_VERIFY_TOKEN=

# ── OPTIONAL: Team alerts ─────────────────────────────────────
# Slack incoming webhook URL (or any webhook) for human handoff alerts
TEAM_ALERT_WEBHOOK_URL=

# ── OPTIONAL: Marketing agent overrides ──────────────────────
# Override the default FX rate and markup for the daily marketing script
FX_RATE=282
MARKUP_RATE=0.25
